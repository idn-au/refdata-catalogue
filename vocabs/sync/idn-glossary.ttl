PREFIX : <https://data.idnau.org/pid/glossary/>
PREFIX dataroles: <https://linked.data.gov.au/def/data-roles/>
PREFIX cs: <https://data.idnau.org/pid/glossary>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

:dataRoles-vocabulary
    a skos:Collection ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Selected concepts from the Data roles vocabulary"@en ;
    skos:inScheme cs: ;
    skos:member dataroles:subjectAgent ;
    skos:prefLabel "Data roles concepts"@en ;
.

:021c5daa-1354-4dd5-b8cf-8eb112e09174
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Tracking changes to resources over time."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Versioning"@en ;
    skos:topConceptOf cs: ;
.

:18ee4c33-fdd0-4cc0-b34a-2c23e30a9897
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Indigenous data is all data generated by, about, or for Aboriginal and Torres Strait Islander people in Australia. Indigenous research data specifically refers to information that is collected, analysed, and interpreted within the context of Indigenous communities, cultures, and knowledge systems. It includes data gathered through research projects conducted by and with Indigenous peoples, as well as data that Indigenous communities have generated and maintained themselves. Indigenous research data includes traditional ecological knowledge, oral histories, cultural practices, and other forms of Indigenous knowledge."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Indigenous Data"@en ;
    skos:topConceptOf cs: ;
.

:27f31245-454a-4d56-990d-0d81cdd7742a
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :ba1db4cf-59f0-4e6d-bf07-003a58aece21 ;
    skos:definition "Indigenous peoples’ rights and wellbeing should be the primary concern at all stages of the data life cycle and across the data ecosystem."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Ethics"@en ;
.

:2cab7bd9-8e6d-408b-8120-58ebf0953607
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :6ac34814-bd33-44ce-a1e9-5c71e88f8d06 ;
    skos:definition "A resource is accessible if it is possible to get a resource by a persistent identifier, or to get information about how to get the resource."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Accessible"@en ;
.

:30998a92-4549-42f7-9d64-2e54daad09ce
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "URL"@en ;
    skos:definition "A Uniform Resource Locator, commonly known as a web address, is a specific string used to reference and locate resources on the internet, such as web pages, images, or documents"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Uniform Resource Locator"@en ;
    skos:topConceptOf cs: ;
.

:324b9d70-1d31-450a-bc5e-a91ab7d65875
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "RDF"@en ;
    skos:definition "Resource Description Framework is a method to describe and exchange graph data"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Resource Description Framework"@en ;
    skos:topConceptOf cs: ;
.

:363a4445-5409-4bb5-8d1c-94ad1d8248c1
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "DOI"@en ;
    skos:definition "A Digital Object Identifier (DOI) is a unique, persistent string of numbers and letters used to identify a specific digital document (research paper, article, or book) and provides a reliable link to its location on the internet"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Digital Object Identifier"@en ;
    skos:topConceptOf cs: ;
.

:37258c00-fea6-4837-8b3c-db9efa85a4e3
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "A tool that checks if metadata conforms to the rules of a profile or standard."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Validator"@en ;
    skos:topConceptOf cs: ;
.

:37e0be20-e754-4f7c-a7c8-cb769e3b8d9d
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "A set of rules or guidelines for creating consistent metadata."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Profile"@en ;
    skos:topConceptOf cs: ;
.

:3c003808-0f67-485a-ad72-184d45dbdca2
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "RIFIC"@en ;
    skos:definition "The Regional Insights for Indigenous Communities (RIFIC) website brings together a range of regional statistics about the health and wellbeing of Aboriginal and Torres Strait Islander people and their communities."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Regional Insights for Indigenous Communities"@en ;
    skos:topConceptOf cs: ;
    schema:citation "https://www.rific.gov.au/"^^xsd:anyURI ;
.

:3ceb53f8-1348-4b7f-a6d5-c30fbf9adc02
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "W3C"@en ;
    skos:definition "World Wide Web Consortium (W3C) is the main international standards organisation for the World Wide Web"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "World Wide Web Consortium"@en ;
    skos:topConceptOf cs: ;
    schema:citation "https://www.w3.org/about/"^^xsd:anyURI ;
.

:3e4ebd2a-a787-44c7-b8b9-697e91df313d
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "A collection of metadata records organised for easy access and use."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Catalogue"@en ;
    skos:topConceptOf cs: ;
.

:3e9a8380-8ede-4805-a18d-63c4719b8cce
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Location Index (Loc-I) is a framework that provides a consistent way to seamlessly integrate data on people, business, and the environment."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "LOC-I"@en ;
    skos:topConceptOf cs: ;
    schema:citation "https://publications.csiro.au/rpr/download?pid=csiro:EP192957&dsid=DS1"^^xsd:anyURI ;
.

:4434bc6d-a7c3-4787-9069-7ee01a057b31
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "IDS"@en ;
    skos:definition "Refers to the rights of Indigenous communities to own and control data about them, their communities, cultures, lands, and resources. It is grounded in principles of self- determination and cultural autonomy, asserting authority over information and knowledge systems."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Indigenous Data Sovereignty"@en ;
    skos:topConceptOf cs: ;
    schema:citation "https://idnau.org/resources/glossary"^^xsd:anyURI ;
.

:4532385d-a41a-4a19-b2a7-1b5af48c4cf0
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "IDG"@en ;
    skos:definition "Indigenous data governance refers to the principles, practices, and systems by which Indigenous communities exercise control over the collection, ownership, management, and use of data that is relevant to them. It recognises the unique rights, interests, and needs of Indigenous peoples regarding their data and aims to ensure that data is collected, stored, and utilised in a manner that respects their self-determination, cultural values, and sovereignty. Indigenous data governance sets the foundations for data democracy at the community level, supporting Indigenous access, generation, and use of data."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Indigenous Data Governance"@en ;
    skos:topConceptOf cs: ;
    schema:citation "https://idnau.org/resources/glossary"^^xsd:anyURI ;
.

:5876f61f-1c82-4ac8-894b-b2bfc4debf8d
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :6ac34814-bd33-44ce-a1e9-5c71e88f8d06 ;
    skos:definition "The ability to share information between different collections or catalogues that might use different tools."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Interoperability"@en ;
.

:61ee574a-e34e-4636-8d6f-5d7ce5807528
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "JavaScript Object Notation for Linked Data"@en ;
    skos:definition "A method for storing and sharing Resource Description Framework metadata."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "JSON-LD"@en ;
    skos:topConceptOf cs: ;
    schema:citation "https://json-ld.org"^^xsd:anyURI ;
.

:63da5279-8772-4f9c-8e55-6f5f6f85129a
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Metadata about the relationships between things."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Ontology"@en ;
    skos:topConceptOf cs: ;
    schema:citation "https://doi.org/10.1006/knac.1993.1008"^^xsd:anyURI ;
.

:68a5e7a4-0158-4120-8a41-1b2c1e19d6cd
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Responsible for the safekeeping and stewardship of data assets and metadata"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Data Custodian/Steward"@en ;
    skos:altLabel 
        "Data Custodian"@en , 
        "Data Steward"@en ;
    skos:topConceptOf cs: ;
.

:6d0f3fed-3187-4825-ad06-35956922dada
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "Concept scheme"@en ,
        "Controlled vocabulary"@en ;
    skos:definition "A set of predefined words or phrases used for describing metadata records consistently."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Vocabulary"@en ;
    skos:topConceptOf cs: ;
.

:6f057945-b9b9-41ac-b7c1-8eb739bee9fa
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "DCAT"@en ;
    skos:definition "Data Catalogue Vocabulary is the international standard for interoperability between data catalogues published on the Web."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Data Catalogue Vocabulary"@en ;
    schema:citation "https://www.w3.org/ns/dcat#"^^xsd:anyURI ;
    skos:topConceptOf cs: ;
.

:6fcf449e-c215-4532-8a56-fc6a44c6a08a
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "IIRC"@en ;
    skos:definition "The Improving Indigenous Research Capabilities is a two-phase project that (phase 1) reviews and refines national and international frameworks of Indigenous Data Governance and Indigenous Data Sovereignty to collectively strengthen the foundations of Aboriginal and Torres Strait Islander data governance principles, which are being translated and applied to Indigenous research data tools and infrastructure, and (phase 2) builds the Indigenous research capability program to enable Aboriginal and Torres Strait Islander peoples and researchers at the interface of research data science and Indigenous knowledge systems to have access to effective research data tools."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Improving Indigenous Research Capabilities project"@en ;
    schema:citation "https://ardc.edu.au/project/improving-indigenous-research-capabilities/"^^xsd:anyURI ;
    skos:topConceptOf cs: ;
.

:7e5ad15d-b108-42ad-a162-48b510d81695
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "information that does not have a pre-defined data model, fixed format, or organizational schema"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Unstructured Data"@en ;
    skos:topConceptOf cs: ;
.

:81b2c6f3-1e8c-4a81-ab3b-7949dfc53456
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :6ac34814-bd33-44ce-a1e9-5c71e88f8d06 ;
    skos:definition "A resource is reuseable if there is permission from those responsible for the resource to use it."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Reuseable"@en ;
.

:87931538-66e5-493d-800f-3c8a54fb8d6b
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "The prefix of an identifier that groups concepts or resources together."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Namespace"@en ;
    skos:topConceptOf cs: ;
.

:87fd7a2a-5afd-4994-b983-33565926ed3e
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "IRI"@en ;
    skos:definition "A Internationalised Resource Identifier (IRI) is an internet protocol standard that extends Uniform Resource Identifiers (URIs) to allow a much wider set of characters"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Internationalised Resource Identifier"@en ;
    skos:topConceptOf cs: ;
.

:8949db57-af31-47fb-a089-b0a77e3feb0e
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Data that provides information about other data, but which is not the content of the data itself"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Metadata"@en ;
    skos:topConceptOf cs: ;
.

:8f9424a2-0856-43eb-8995-cfd25e3aa188
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "IDNC"@en ;
    skos:definition "The Indigenous Data Network Catalogue of Indigenous datasets includes metadata held by IDCs across Australia, including research data generated by the IDN in partnership with those custodians. The IDNC demonstrates improved metadata models and rating systems for data and metadata to improve Indigenous data governance."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Indigenous Data Network Catalogue"@en ;
    skos:topConceptOf cs: ;
.

:8f9bde6c-2d32-4a23-a2b0-e3c79d91f06d
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "ORCID"@en ;
    skos:definition "Open Researcher and Contributor ID (ORCID) is a free, unique, 16-digit persistent digital identifier for researchers and academic contributors"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Open Researcher and Contributor ID"@en ;
    skos:topConceptOf cs: ;
    schema:citation "https://orcid.org/"^^xsd:anyURI ;
.

:9477ce3a-6ac5-41ec-8f0a-0c662d93f909
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "A cloud-based digital infrastructure that coupled with governance strateies that allow a community to use, share, manage and analysee its data"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Data Commons"@en ;
    skos:topConceptOf cs: ;
.

:9a1b7bf7-13b3-437a-9892-b4acfd6fc990
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :ba1db4cf-59f0-4e6d-bf07-003a58aece21 ;
    skos:definition "Those working with Indigenous data have a responsibility to share how those data are used to support Indigenous peoples’ self-determination and collective benefit."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Responsibility"@en ;
.

:9bfb626e-2ee0-4063-82c0-137e97088d9a
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :ba1db4cf-59f0-4e6d-bf07-003a58aece21 ;
    skos:definition "Indigenous peoples’ rights and interests in Indigenous data must be recognised and their authority to control such data be empowered."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Authority to Control"@en ;
.

:9c8ca3b5-cf7d-4c73-83c1-c5c7e5cabb9f
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "TTL"@en ,
        "Terse RDF Triple Language"@en ;
    skos:definition "A method for storing and sharing Resource Description Framework metadata."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Turtle"@en ;
    skos:topConceptOf cs: ;
    schema:citation "https://www.w3.org/TR/turtle/"^^xsd:anyURI ;
.

:a06424dd-4d26-4f01-85ee-ca8ff5dfc641
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "The relationship between people or organisations and catalogued resources."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Role"@en ;
    skos:topConceptOf cs: ;
.

:a5cac5df-9d31-4f06-bf2a-fc32bb403e6c
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "UUID"@en ;
    skos:broader :6c014466-c95f-4df5-a6cc-a1a50beffab0 ;
    skos:definition "A type of persistent identifier that is universally unique."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Universally Unique Identifier"@en ;
.

:a877b16b-2581-4339-9da4-87774b14980a
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "LC labels"@en ;
    skos:definition "Concepts that express local and specific conditions such as community rules, governance and protocols for using and sharing knowledge."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Local context labels"@en ;
    skos:topConceptOf cs: ;
    schema:citation "https://localcontexts.org/labels/about-the-labels/"^^xsd:anyURI ;
.

:ac5eba92-55dc-494c-9d9f-b331e05e7c8d
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "A single unit of meaning or part of knowledge. Conepts are expressed as words or terms. Many concepts from the same knowledge system belong to a vocabulary."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Concept"@en ;
    skos:topConceptOf cs: ;
    schema:citation "https://www.w3.org/TR/skos-reference/#concepts"^^xsd:anyURI ;
.

:ae150d66-29de-4745-92f3-52760a74e82d
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "ICIP"@en ;
    skos:definition "Indigenous Cultural and Intellectual Property refers to the traditoional knowledge, traditional cultural expression and cultural heritage of Indigenous peoples"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Indigenous Cultural and Intellectual Property"@en ;
    schema:citation "https://www.library.gov.au/first-australians/indigenous-cultural-and-intellectual-property"^^xsd:anyURI ;
    skos:topConceptOf cs: ;
.

:b3efeb87-8b83-489f-86b4-a47b36e5ed2f
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :ba1db4cf-59f0-4e6d-bf07-003a58aece21 ;
    skos:definition "Data ecosystems shall be designed and function in ways that enable Indigenous peoples to derive benefit from the data."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Collective Benefit"@en ;
.

:b6360ba0-c76d-4d47-85f6-1df8a475d7f7
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition """For the purposes of the IIRC project, we define Indigenous data custodian as any individual, organisation, institution, or government agency that holds, manages, stores, or controls data that relates to Aboriginal and Torres Strait

Islander peoples, communities, cultures, lands, or knowledges, including:
(1) Aboriginal and Torres Strait Islander communities and organisations.
(2) Universities, researchers and other research organisations.
(3) The GLAM sector, including libraries, archives and museums.
(4) Commonwealth, state, territory and local governments; and
(5) Private sector (including not-for-profit)."""@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Indigenous Data Custodian"@en ;
    schema:citation "https://ardc.edu.au/wp-content/uploads/2024/08/iirc-2024-stage-2-ardc-project-plan-redacted-1.pdf"^^xsd:anyURI ;
    skos:topConceptOf cs: ;
.

:bd5028a2-8536-4ca3-bef8-1525790271f7
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Within the IDN project, we refer to Indigenous research data as all data generated by, about or for Aboriginal and Torres Strait Islander people in Australia. Indigenous research data specifically refers to information that is collected, analysed, and interpreted within the context of Indigenous communities, cultures, and knowledge systems. It includes data gathered through research projects conducted by and with Indigenous peoples, as well as data that Indigenous communities have generated and maintained themselves. Indigenous research data includes traditional ecological knowledge, oral histories, cultural practices, and other forms of Indigenous knowledge that may not fit traditional Western research paradigms. It may involve collaborative research approaches that prioritise Indigenous self-determination, community engagement, and the equitable sharing of benefits."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Indigenous research data"@en ;
    skos:topConceptOf cs: ;
.

:c44493ef-8c87-4e41-ac6d-2a0961203a07
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "Metadata tool"@en ;
    skos:definition "A tool that helps to create and upload metadata about resources."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Metadata Entry Form"@en ;
    skos:topConceptOf cs: ;
.

:c8cd3062-1034-46d5-b866-1cf2c8800bae
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "A cloud-based platform that acts as a hosting service for software development projects, using Git for version control"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Github"@en ;
    skos:topConceptOf cs: ;
    schema:citation "https://docs.github.com/en"^^xsd:anyURI ;
.

:d1ea9773-9686-4dc5-bf72-455544f322cf
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "IP"@en ;
    skos:definition "Intellectual property (IP) refers to creations of the mind. It could include a brand, logo, invention, design or artistic work, or new plant variety"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Intellectual Property"@en ;
    skos:topConceptOf cs: ;
    schema:citation "https://www.ipaustralia.gov.au/understanding-ip"^^xsd:anyURI ;
.

:d7907201-7eaa-4c08-80e1-404c3c2af5c1
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:broader :6ac34814-bd33-44ce-a1e9-5c71e88f8d06 ;
    skos:definition "A resource is findable if it is possible to find that resource. Resources are findable when they are described with consistent metadata and vocabulary concepts."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Findable"@en ;
.

:d8ad0dfc-c164-4f72-8f49-71d4605b5666
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "An extension of the World Wide Web, developed by W3C to make web content machine-readable and understandable. This process structures data with semantic metadata transforming the web from a collection of documents into an interopable database"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Semantic Web"@en ;
    schema:citation "https://www.w3.org/2001/sw/wiki/Main_Page"^^xsd:anyURI ;
    skos:topConceptOf cs: ;
.

:d9c130fc-facb-448b-90df-4f4aa68eb206
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "BC Labels"@en ;
    skos:definition "Biocultural Labels are tools developed by the North American organisation Local Contexts to acknowledge Indigenous rights and interests in data, particularly in relation to genetic resources and associated information. These labels are designed to be customised by Indigenous communities to articulate expectations and conditions for the appropriate use of collections and data. While intended to support Indigenous authority over biocultural knowledge, their applicability and effectiveness outside North American contexts—such as in Australia—require careful consideration."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Biocultural Labels"@en ;
    schema:citation "https://localcontexts.org/labels/biocultural-labels/"^^xsd:anyURI ;
    skos:broader :a877b16b-2581-4339-9da4-87774b14980a ;
.

:ddf05cc9-267b-4d1a-81dd-896e3d6d0816
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Linked data is structured data which is associated to other data"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Linked Data"@en ;
    schema:citation "https://www.w3.org/DesignIssues/LinkedData.html"^^xsd:anyURI ;
    skos:topConceptOf cs: ;
.

:de93757d-c96e-4d45-b56d-aafd4d607fd4
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "URI"@en ;
    skos:definition "A Uniform Resource Identifier is a compact string of characters used to uniquely identify an abstract or physical resource on the internet"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Uniform Resource Identifier"@en ;
    skos:topConceptOf cs: ;
.

:df76959d-d915-4ce6-9bc8-8043dabc0cc2
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "Qualified attribution"@en ;
    skos:definition "Metadata about the agent and the role that they played with respect to a resource."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Attribution"@en ;
    skos:topConceptOf cs: ;
.

:e38ab495-1276-45d0-88ce-1fbf7dd2aa3e
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Commonwealth of Australia, Framework for Governance of Indigenous Data, was published 2024 and aims to provide “guidance to the APS in improving governance practices for data related to Aboriginal and Torres Strait Islander people. It seeks to move the APS beyond traditional methods of consultation, to ensure Aboriginal and Torres Strait Islander people have an equal position at the decision-making table on matters affecting them."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Framework for Governance of Indigenous Data"@en ;
    schema:citation "https://www.niaa.gov.au/our-work/data-evaluation-and-research/framework-governance-indigenous-data-gid"^^xsd:anyURI ;
    skos:topConceptOf cs: ;
.

:e66f4ec8-c59c-401a-bd53-a33ca206cd61
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "RDC"@en ;
    skos:definition "Research Data Commons"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Research Data Commons"@en ;
    skos:broader :9477ce3a-6ac5-41ec-8f0a-0c662d93f909 ;
.

:f017c7f2-a312-4ae9-9efe-1eb25a232c95
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Information that adheres to a rigid, predefined model or schema, organizing it into a highly organized, machine-readable format"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Structured Data"@en ;
    skos:topConceptOf cs: ;
.

:f3ddb2c6-6bcd-411a-9fd0-fb2349a7d05d
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "TK Labels"@en ;
    skos:definition "Traditional Knowledge Labels, also developed by Local Contexts, enable communities to express local and specific conditions for sharing and engaging in research and relationships in ways that align with existing community rules, governance, and protocols for using, sharing, and circulating knowledge and data. These labels seek to provide a normative framework in signalling provenance and permissions; however, their relevance and practical integration within Australian Indigenous data governance frameworks remain contested and warrant critical engagement."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Traditional Knowledge Labels"@en ;
    schema:citation "https://localcontexts.org/labels/traditional-knowledge-labels/"^^xsd:anyURI ;
    skos:broader :a877b16b-2581-4339-9da4-87774b14980a ;
.

:f962d3c0-b94d-4306-9c47-f1c430509101
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "An item included in a catalogue. Each resource is described with metadata."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Resource"@en ;
    skos:topConceptOf cs: ;
.

:fe51a1c3-b6dd-43ea-9976-2a194b389f06
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "The Humanities, Arts, Social Sciences and Indigenous Research Data Commons is an initiative of the ARDC. It resources projects in partnership with research institutions, non-governmental organisations and government"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "HASS&I RDC"@en ;
    schema:citation "https://ardc.edu.au/hass-and-indigenous-research-data-commons/"^^xsd:anyURI ;
    skos:topConceptOf cs: ;
.

<https://data.idnau.org/pid/org/aiatsis>
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "AIATSIS"@en ;
    skos:definition "The Australian Institute of Aboriginal and Torres Strait Islander Studies (AIATSIS) is an Indigenous-led, national institute that celebrates, educates and inspires people from all walks of life to connect with the knowledge, heritage and cultures of Australia’s First Peoples. Our vision is a world in which Aboriginal and Torres Strait Islander knowledge and cultures are recognised, respected, celebrated and valued."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Australian Institute of Aboriginal and Torres Strait Islander Studies"@en ;
    skos:topConceptOf cs: ;
    schema:citation "https://aiatsis.gov.au/"^^xsd:anyURI ;
.

<https://data.idnau.org/pid/org/aihw>
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "AIHW"@en ;
    skos:definition "The AIHW is an independent statutory Australian Government agency producing authoritative and accessible information and statistics to inform and support better policy and service delivery decisions, leading to better health and wellbeing for all Australians."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Australian Institute of Health and Welfare"@en ;
    skos:topConceptOf cs: ;
    schema:citation "https://www.aihw.gov.au/"^^xsd:anyURI ;
.

<https://data.idnau.org/pid/org/aps>
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "APS"@en ;
    skos:definition "The Australian Public Service (APS) comprises entities that employ their staff under the Public Service Act 1999 (PS Act). This includes all departments of state, and some other entities. Generally, APS agencies are ‘non-corporate’, being components of the legal entity that is the Commonwealth."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Australian Public Service"@en ;
    skos:topConceptOf cs: ;
    schema:citation "https://www.apsc.gov.au/"^^xsd:anyURI ;
.

<https://data.idnau.org/pid/org/ardc>
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "ARDC"@en ;
    skos:definition "The ARDC is Australia’s leading research data infrastructure facility."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Australian Research Data Commons"@en ;
    skos:topConceptOf cs: ;
    schema:citation "https://ardc.edu.au/"^^xsd:anyURI ;
.

<https://data.idnau.org/pid/org/atsichs>
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "ATSICHS"@en ;
    skos:definition "The Aboriginal and Torres Strait Islander Community Health Service (ATSICHS) Brisbane is a not-for-profit community-owned health care and community services organisation delivering on the unique health and wellbeing needs of Aboriginal and Torres Strait Islander peoples in greater Brisbane and Logan."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Aboriginal and Torres Strait Islander Community Health Service"@en ;
    skos:topConceptOf cs: ;
    schema:citation "https://atsichsbrisbane.org.au/"^^xsd:anyURI ;
.

<https://data.idnau.org/pid/org/naaja>
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "NAAJA"@en ;
    skos:definition "The North Australian Aboriginal Justice Agency (NAAJA) is the provider of legal aid services to Aboriginal people in the Northern Territory."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "North Australian Aboriginal Justice Agency"@en ;
    skos:topConceptOf cs: ;
    schema:citation "https://www.naaja.org.au/"^^xsd:anyURI ;
.

<https://data.idnau.org/pid/org/niaa>
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel "NIAA"@en ;
    skos:definition "The National Indigenous Australians Agency (NIAA) works to ensure that the needs and aspirations of Aboriginal and Torres Strait Islander peoples are met through government policies, programs and services."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "National Indigenous Australians Agency"@en ;
    skos:topConceptOf cs: ;
    schema:citation "https://www.niaa.gov.au/"^^xsd:anyURI ;
.

