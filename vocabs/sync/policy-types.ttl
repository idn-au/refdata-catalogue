PREFIX : <https://data.idnau.org/pid/vocab/policy-types/>
PREFIX cs: <https://data.idnau.org/pid/vocab/policy-types>
PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX dataroles: <https://linked.data.gov.au/def/data-roles/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

:data-policy
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Short statements of management intent and fundamental rules governing the creation, acquisition, integrity, security, quality and use of data and information."@en ;
    skos:scopeNote "Use for resources governed by a data governance document, such as a data policy, procedure, principle etc. For resources governed by an Indigenous data governance document, USE Indigenous data governance."@en ;
    skos:historyNote "DAMA-DMBOK Guide, 1st edition, pg.47" ;
    skos:inScheme cs: ;
    skos:prefLabel "data policy"@en ;
    skos:altLabel
      "data governance"@en ,
      "data management"@en ;
    skos:broader :policy ;
    skos:related :indigenous-data-governance ;
    dcterms:replaces 
      :data-governance, 
      :data-management ;
.

:indigenous-data-governance
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "The right of Indigenous Peoples to autonomously decide what, how, and why Indigenous Data are collected, accessed, and used. It ensures that data on or about Indigenous Peoples reflects our priorities, values, clutures, worldviews, and diversity (Maiam nayri Wingara, 2018)."@en ;
    skos:scopeNote "Use for resources governed by an Indigenous data governance document, such as an Indigenous data policy, procedure, principle etc. For resources governed by a non-Indigenous data governance document, USE Data governance"@en ;
    dcterms:source "https://www.maiamnayriwingara.org"^^xsd:anyURI ;
    skos:inScheme cs: ;
    skos:prefLabel "indigenous data governance"@en ;
    skos:altLabel
      "Indigenous data policy"@en ,
      "Indigenous data management"@en ;
    skos:broader :data-governance ;
    skos:related :data-policy ;
.

<https://kurrawong.ai>
    a schema:Organization ;
    schema:name "KurrawongAI" ;
    schema:url "https://kurrawong.ai"^^xsd:anyURI ;
.

<https://linked.data.gov.au/org/idn>
    a schema:Organization ;
    schema:name "Indigenous Data Network" ;
    schema:url "https://mspgh.unimelb.edu.au/centres-institutes/centre-for-health-equity/research-group/indigenous-data-network"^^xsd:anyURI ;
.

:0.2 rdfs:label "0.2" .

cs:
    a skos:ConceptScheme ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/experimental> ;
    owl:versionIRI :0.2 ;
    skos:definition "This vocab is for characterising policy documentation to improve the ability to apply FAIR and CARE scores."@en ;
    skos:hasTopConcept
        :data-policy ,
        :indigenous-data-governance ;
    skos:historyNote """This vocab is for characterising policy documentation to improve the ability to apply FAIR and CARE scores.
    
    5 May 2026 [Les K] Six concepts deprecated. Remaining two concepts distinguish Indigenous from non-Indigenous governance document types."""@en ;
    skos:prefLabel "Policy Types"@en ;
    prov:qualifiedAttribution
        [
            dcat:hadRole dataroles:custodian ;
            prov:agent
                [
                    a schema:Person ;
                    schema:name "M Smith" ;
                    schema:email "margie@kurrawong.ai"^^xsd:anyURI ;
                ] ;
        ] ;
    schema:creator <https://kurrawong.ai> ;
    schema:dateCreated "2024-02-23"^^xsd:date ;
    schema:dateModified "2026-05-05"^^xsd:date ;
    dcat:keyword
        "data governance" ,
        "data management" ,
        "data policy" ,
        "indigenous data" ;
    schema:publisher <https://linked.data.gov.au/org/idn> ;
    schema:version "0.2" ;
.

# deprecated concepts

:data-governance
owl:deprecated "true"^^xsd:boolean
.

:data-management
owl:deprecated "true"^^xsd:boolean
.

:governance
owl:deprecated "true"^^xsd:boolean
.

:policy
owl:deprecated "true"^^xsd:boolean
.

:principle
owl:deprecated "true"^^xsd:boolean
.

:procedure
owl:deprecated "true"^^xsd:boolean
.
