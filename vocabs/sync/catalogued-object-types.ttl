PREFIX : <https://data.idnau.org/pid/vocab/cat-obj-types/>
PREFIX cs: <https://data.idnau.org/pid/vocab/cat-obj-types>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

:semantic-web-resources
    a skos:Collection ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Resources that accord with Semantic Web principles"@en ;
    skos:inScheme cs: ;
    skos:member
        schema:DataModel ,
        schema:DataValidationRules ,
        schema:DefinedTermSet ;
    skos:prefLabel "Semantic Web resources"@en ;
    skos:scopeNote "Use this collection to contain ontologies, vocabularies and semantic spatial reference datasets" ;
.

:DataValidationRules
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "Supplies instructions about how to verify conformance of data to the profile"@en ;
    skos:historyNote "Definition taken from the Validation concept in the Profiles Vocabulary - Resource Roles vocabulary" ;
    skos:inScheme cs: ;
    skos:prefLabel "Data Validation Rules"@en ;
    skos:topConceptOf cs: ;
.

:ShapesGraph
    a skos:Concept ;
    rdfs:isDefinedBy <https://schema.org> ;
    skos:definition "A set of SHACL shapes used to validate RDF data."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Shapes Graph"@en ;
    skos:scopeNote "2026-03: This term is proposed to schema.org but not yet accepted, nevertheless it can be used within this vocabulary" ;
    skos:topConceptOf cs: ;
.

:SpatialDataset
    a skos:Concept ;
    rdfs:isDefinedBy <https://schema.org> ;
    skos:definition "A specialised form of digital dataset containing spatial objects - features."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Spatial Dataset"@en ;
    skos:scopeNote "2026-03: This term is proposed to schema.org but not yet accepted, nevertheless it can be used within this vocabulary" ;
    skos:topConceptOf cs: ;
.

schema:Book
    a skos:Concept ;
    rdfs:isDefinedBy <https://schema.org> ;
    skos:definition "A book."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Book"@en ;
    skos:topConceptOf cs: ;
.

schema:Dataset
    a skos:Concept ;
    rdfs:isDefinedBy <https://schema.org> ;
    skos:definition "A body of structured information describing some topic(s) of interest."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Dataset"@en ;
    skos:topConceptOf cs: ;
.

schema:DigitalDocument
    a skos:Concept ;
    rdfs:isDefinedBy <https://schema.org> ;
    skos:definition "An electronic file or document."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Digital Document"@en ;
    skos:topConceptOf cs: ;
.

schema:Map
    a skos:Concept ;
    rdfs:isDefinedBy <https://schema.org> ;
    skos:definition "A map."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Map"@en ;
    skos:topConceptOf cs: ;
.

schema:Movie
    a skos:Concept ;
    rdfs:isDefinedBy <https://schema.org> ;
    skos:definition "A movie."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Movie"@en ;
    skos:topConceptOf cs: ;
.

schema:Painting
    a skos:Concept ;
    rdfs:isDefinedBy <https://schema.org> ;
    skos:definition "A painting."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Painting"@en ;
    skos:topConceptOf cs: ;
.

schema:Photograph
    a skos:Concept ;
    rdfs:isDefinedBy <https://schema.org> ;
    skos:definition "A photograph."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Photograph"@en ;
    skos:topConceptOf cs: ;
.

schema:Report
    a skos:Concept ;
    rdfs:isDefinedBy <https://schema.org> ;
    rdfs:subClassOf schema:Article ;
    skos:definition "A Report generated by governmental or non-governmental organization."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Report"@en ;
    skos:topConceptOf cs: ;
.

schema:Sculpture
    a skos:Concept ;
    rdfs:isDefinedBy <https://schema.org> ;
    skos:definition "A piece of sculpture."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Sculpture"@en ;
    skos:topConceptOf cs: ;
.

schema:SoftwareApplication
    a skos:Concept ;
    rdfs:isDefinedBy <https://schema.org> ;
    skos:definition "A software application."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Software Application"@en ;
    skos:topConceptOf cs: ;
.

schema:SoftwareSourceCode
    a skos:Concept ;
    rdfs:isDefinedBy <https://schema.org> ;
    skos:definition "Computer programming source code. Example: Full (compile ready) solutions, code snippet samples, scripts, templates."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Software Source Code"@en ;
    skos:topConceptOf cs: ;
.

schema:Thesis
    a skos:Concept ;
    rdfs:isDefinedBy <https://schema.org> ;
    skos:definition "A thesis or dissertation document submitted in support of candidature for an academic degree or professional qualification."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Thesis"@en ;
    skos:topConceptOf cs: ;
    schema:isPartOf <https://bib.schema.org> ;
    schema:source "http://www.productontology.org/id/Thesis"^^xsd:anyURI ;
.

schema:VisualArtwork
    a skos:Concept ;
    rdfs:isDefinedBy <https://schema.org> ;
    skos:definition "A work of art that is primarily visual in character."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Visual Artwork"@en ;
    skos:topConceptOf cs: ;
.

schema:WebSite
    a skos:Concept ;
    rdfs:isDefinedBy <https://schema.org> ;
    skos:definition "A WebSite is a set of related web pages and other items typically served from a single web domain and accessible via URLs."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Web Site"@en ;
    skos:topConceptOf cs: ;
.

<https://linked.data.gov.au/org/idn>
    a schema:Organization ;
    schema:name "Indigenous Data Network" ;
    schema:url "https://www.idnau.org"^^xsd:anyURI ;
.

schema:Article
    a skos:Concept ;
    rdfs:isDefinedBy <https://schema.org> ;
    skos:definition "An article, such as a news article or piece of investigative report. Newspapers and magazines have articles of many different types and this is intended to cover them all.\\n\\nSee also [blog post](http://blog.schema.org/2014/09/schemaorg-support-for-bibliographic_2.html)."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Article"@en ;
    skos:topConceptOf cs: ;
.

schema:DataModel
    a skos:Concept ;
    rdfs:isDefinedBy <https://schema.org> ;
    skos:definition "A conceptual blueprint that defines how data is structured"@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Data Model"@en ;
    skos:scopeNote "2026-03: This term is proposed to schema.org but not yet accepted, nevertheless it can be used within this vocabulary" ;
    skos:topConceptOf cs: ;
.

schema:DefinedTermSet
    a skos:Concept ;
    rdfs:isDefinedBy <https://schema.org> ;
    skos:definition "A set of defined terms, for example a set of categories or a classification scheme, a glossary, dictionary or enumeration."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "Defined Term Set"@en ;
    skos:topConceptOf cs: ;
.

cs:
    a skos:ConceptScheme ;
    skos:definition "The types of things in a catalogue"@en ;
    skos:hasTopConcept
        :DataValidationRules ,
        :ShapesGraph ,
        :SpatialDataset ,
        schema:Article ,
        schema:Book ,
        schema:DataModel ,
        schema:Dataset ,
        schema:DefinedTermSet ,
        schema:DigitalDocument ,
        schema:Map ,
        schema:Movie ,
        schema:Painting ,
        schema:Photograph ,
        schema:Report ,
        schema:Sculpture ,
        schema:SoftwareApplication ,
        schema:SoftwareSourceCode ,
        schema:Thesis ,
        schema:VisualArtwork ,
        schema:WebSite ;
    skos:historyNote """2026-05: Added ShapesGraph & SpatialDataset

2026-03: This vocabulary was established in 2026 to assist the IDN with managing multiple catalogues with multiple types of things in them."""@en ;
    skos:prefLabel "Catalogued Object Types"@en ;
    schema:copyrightNotice "(c) Indigenous Data Network, 2026" ;
    schema:creator <https://linked.data.gov.au/org/idn> ;
    schema:dateCreated "2026-03-10"^^xsd:date ;
    schema:dateModified "2026-05-06"^^xsd:date ;
    schema:license <http://purl.org/NET/rdflicense/cc-by4.0> ;
    schema:publisher <https://linked.data.gov.au/org/idn> ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/stable> ;
.
